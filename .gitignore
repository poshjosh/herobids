# Custom

.ignore
app-data/

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Environment & secrets
.env
.env.*
!.env.example
!.env.ops.dev.example
!.env.ops.environment.example
!.env.backend.example
!infra/hetzner/.env.environment.example

# Config (contains credentials)
config.yaml
config.json
!config.example.yaml

# Dev descriptor signing private key — generated by scripts/ts/generate-dev-descriptor.ts.
# The committed descriptor + public key (traderton.descriptor.json / .pub.pem) are the
# trust anchors; the private key is only needed to re-sign and must NEVER be committed.
config/external-backends/*.dev-key.pem

# IDE
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Testing
coverage/
docs/test-reports/e2e-report/
tests/e2e/test-results/

# Redis & Postgres local data
.data/
docker-volumes/

# Drizzle
drizzle/meta/.snapshot.json

# Terraform
*.tfstate
*.tfstate.*
infra/hetzner/terraform.tfstate.d/
.terraform/
# Per-env TF_DATA_DIRs used by terraform_output (infra/hetzner/scripts/_ssh_opts.sh)
infra/hetzner/.terraform-envs/
*.tfvars
!.tfvars.example

# Misc
*.pid
*.seed
*.tgz
