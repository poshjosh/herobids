# Environment
NODE_ENV=development
LOG_FORMAT=pretty          # pretty | json; auto-set to pretty when NODE_ENV=development

# Database
DATABASE_URL=postgres://herobids:herobids@localhost:5432/herobids

# Redis
REDIS_URL=redis://localhost:6379

# API
PORT=3000

# Authentication
AUTH_JWT_SECRET=           # min 32 chars; node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Alerting
TELEGRAM_BOT_TOKEN=

# Credential encryption (64 hex chars = 32 bytes for AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

# LLM — at least one provider key required for agent mode
LLM_API_KEY=               # generic fallback if provider-specific key is absent
LLM_API_KEY_ANTHROPIC=
LLM_API_KEY_OPENAI=

# Venue credentials — Hyperliquid
HYPERLIQUID_API_KEY=            # API wallet address
HYPERLIQUID_SECRET=             # API wallet private key
HYPERLIQUID_ACCOUNT_ADDRESS=    # main account (vault) address

# Venue credentials — Bybit
BYBIT_API_KEY=
BYBIT_SECRET=

# Venue credentials — 1inch (Base)
ONEINCH_API_KEY=
ONEINCH_PRIVATE_KEY=       # EVM wallet private key used for transaction signing
BASE_RPC_URL=              # Base RPC endpoint (default: https://mainnet.base.org)

# Venue credentials — Jupiter (Solana)
SWAP_WALLET_ADDRESS=       # Solana wallet public address
SOLANA_RPC_URL=            # Solana RPC endpoint (default: https://api.mainnet-beta.solana.com)

# Billing — Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Billing — Creem
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=

# Web development (Vite)
VITE_API_PROXY_TARGET=http://localhost:3000

# Agent container env — injected by DockerAgentManager; 
# !!! DO NOT SET MANUALLY !!!
# AGENT_ID=
# SESSION_ID=
# AGENT_CONFIG=
# TOOL_POLICY=
