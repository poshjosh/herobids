# Environment
NODE_ENV=development
LOG_FORMAT=pretty          # pretty | json; auto-set to pretty when NODE_ENV=development

# Database
DATABASE_URL=postgres://herobids:herobids@localhost:5432/herobids

# Redis
REDIS_URL=redis://localhost:6379

# API
PORT=3000

# Authentication
AUTH_JWT_SECRET=           # min 32 chars; node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Alerting
TELEGRAM_BOT_TOKEN=

# Credential encryption (64 hex chars = 32 bytes for AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

# LLM — at least one provider key required for agent mode
# OpenRouter recommended: routes to any model via a single key (https://openrouter.ai)
LLM_PROVIDER=openrouter
LLM_MODEL=anthropic/claude-sonnet-4-5
LLM_API_KEY_OPENROUTER=
LLM_API_KEY=               # generic fallback if provider-specific key is absent
LLM_API_KEY_ANTHROPIC=
LLM_API_KEY_OPENAI=

# Venue RPC endpoints (credentials stored encrypted in DB — see scripts/.env.example)
BASE_RPC_URL=              # Base RPC endpoint (default: https://mainnet.base.org)
SOLANA_RPC_URL=            # Solana RPC endpoint (default: https://api.mainnet-beta.solana.com)

# Billing — provider selection (default: mock for local dev)
# Set to 'creem' or 'stripe' in production alongside the provider credentials below
BILLING_PRIMARY_PROVIDER=mock

# Billing — Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Billing — Creem
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=

# Web development (Vite)
VITE_API_PROXY_TARGET=http://localhost:3000

# Agent container env — injected by DockerAgentManager; 
# !!! DO NOT SET MANUALLY !!!
# AGENT_ID=
# SESSION_ID=
# AGENT_CONFIG=
# TOOL_POLICY=
