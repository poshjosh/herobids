# ── OpenAIdom Environment Variables ───────────────────────
#
# ENVIRONMENT FILES:
#   .env.example        — this template (committed, no secrets)
#   .env.ops.remote.example — ops credential template (committed, no secrets)
#   infra/hetzner/.env.staging — staging server secrets (gitignored)
#   infra/hetzner/.env.prod    — production server secrets (gitignored)
#   .env.ops.staging        — staging API credentials for dev scripts (gitignored)
#   .env.ops.prod           — production API credentials for dev scripts (gitignored)
#
# PER-ENVIRONMENT GUIDANCE:
#   STAGING (.env.staging):
#     - Use separate OAuth client IDs (Google Cloud test project)
#     - Use a distinct Telegram bot for staging alerts
#     - Billing: keep BILLING_PRIMARY_PROVIDER=mock (config/staging.yaml defaults)
#     - LLM keys: use test/demo-tier API keys with lower rate limits
#     - JWT secret: generate a separate secret, never reuse the production one
#     - Webhook URLs: use staging domain (staging.openaidom.com), never production
#
#   PRODUCTION (.env.prod):
#     - Billing: set BILLING_PRIMARY_PROVIDER=creem (or stripe)
#     - All secrets must be production-grade (separate from staging)
#     - NODE_ENV=production is set by docker-compose.prod.yaml, not here
#
# Environment
LOG_FORMAT=pretty          # pretty | json; auto-set to pretty when NODE_ENV=development

# Database
DATABASE_URL=postgres://herobids:herobids@localhost:5432/herobids

# Redis
REDIS_URL=redis://localhost:6379

# API
PORT=3000
# DATASETS_DIR=            # dir for uploaded/generated datasets (default: /tmp/herobids-datasets)

# Authentication
# NOTE: AUTH_JWT_SECRET is referred to as AUTH_SECRET in deployment plans/docs — same variable.
AUTH_JWT_SECRET=           # min 32 chars; node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_PUBLIC_BASE_URL=      # public base URL of the API (e.g. https://api.example.com) — required in production for OAuth redirects
AUTH_FRONTEND_ORIGIN=      # frontend origin for CORS (e.g. https://app.example.com) — required in production
# AUTH_JWT_TTL_SECS=       # session JWT lifetime in seconds (optional; default in config/default.yaml)
# AUTH_EXCHANGE_CODE_TTL_SECS=   # OAuth exchange-code lifetime in seconds (optional; default in config/default.yaml)
# passwordless login-link rate/TTL controls (optional; defaults in config/default.yaml)
# AUTH_LOGIN_LINK_TTL_SECS=
# AUTH_LOGIN_LINK_RESEND_COOLDOWN_SECS=
# AUTH_LOGIN_LINK_MAX_SENDS_PER_WINDOW=
# AUTH_LOGIN_LINK_WINDOW_SECS=
# AUTH_LOGIN_LINK_MAX_SENDS_PER_IP_WINDOW=
# login/registration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# agentic email sending
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# OAuth redirect URI registered for the Gmail integration (optional; default in config/default.yaml)
GMAIL_REDIRECT_URI=
# per-agent daily Gmail send cap (optional; injected into the agent container)
# GMAIL_DAILY_SEND_LIMIT=

# Alerting
# ALERTS_ENABLED=true          # master switch for outbound alerts (optional; default in config/default.yaml)
TELEGRAM_BOT_TOKEN=
# separate from bot token; used to validate incoming Telegram webhook requests
TELEGRAM_WEBHOOK_SECRET=
# public HTTPS URL for setWebhook (e.g. https://api.example.com/telegram/webhook); omit for local dev
# TELEGRAM_WEBHOOK_URL=

# Credential encryption (64 hex chars = 32 bytes for AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

# LLM — API keys (secrets). Provider/model/baseUrl defaults are in config/default.yaml.
# LLM_API_KEY — generic fallback used when no provider-specific key is found
LLM_API_KEY=
LLM_API_KEY_OPENROUTER=
LLM_API_KEY_ANTHROPIC=
LLM_API_KEY_OPENAI=
LLM_API_KEY_DEEPSEEK=

# LLM — provider/model overrides (optional; defaults are in config/default.yaml)
# LLM_PROVIDER=anthropic        # openrouter | openai | anthropic | ollama
# LLM_MODEL=claude-sonnet-4-5   # model name passed to the provider
# LLM_BASE_URL=                 # custom base URL (required for Ollama / self-hosted)
# LLM_MAX_TOKENS=4096           # max tokens per LLM call
# LLM_TIMEOUT_MS=180000         # LLM call timeout in ms
# LLM_SERVER_COST_USD_PER_HOUR=0.02  # self-hosted server cost/hour used in runtime billing estimates

# https://tavily.com= web search tool —  (free tier: 1,000 credits/month, no card required)
TAVILY_API_KEY=

# https://scrapfly.io/ = anti-bot/Cloudflare bypass proxy for scraping.
# Used by the Forex Factory economic-calendar adapter (Cloudflare blocks
# cloud/datacenter IPs like Hetzner's). Optional locally (falls back to a
# direct HTTP/1.1 fetch), but required for the fetch to succeed on staging/
# production hosts. (free tier: 1,000 credits/month, no card required)
SCRAPFLY_API_KEY=

# Market data providers
# required when marketData.birdeye.enabled is true; https://birdeye.so/developers
BIRDEYE_API_KEY=
# required when marketData.coinMarketCap.enabled is true; https://coinmarketcap.com/api/
COINMARKETCAP_API_KEY=
# required when venues.1inch.walletGeneration.enabled is true
ONEINCH_API_KEY=
# required when venues.jupiter.walletGeneration.enabled is true
JUPITER_API_KEY=
# optional CoinGecko / GeckoTerminal Pro key — enables the paid on-chain tier when set
COINGECKO_API_KEY=

# Venue RPC endpoints
BASE_RPC_URL=              # Base RPC endpoint (default: https://mainnet.base.org)
SOLANA_RPC_URL=            # Solana RPC endpoint (default: https://api.mainnet-beta.solana.com)

# Billing — provider selection (default: mock for local dev)
# Set to 'creem' or 'stripe' in production alongside the provider credentials below
BILLING_PRIMARY_PROVIDER=mock

# Billing — Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Billing — Creem
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=

# dev-only env var that tells Vite's dev server where to forward /api requests
VITE_API_PROXY_TARGET=http://localhost:3000

# Email — outbound delivery via Amazon SES.
# EMAIL_PROVIDER=ses              # provider selector
# EMAIL_FROM_EMAIL=               # sender address (verified in SES)
# EMAIL_REPLY_TO_EMAIL=           # optional reply-to address
# EMAIL_TIMEOUT_MS=               # outbound send timeout in ms (optional; default in config/default.yaml)
# AWS_REGION=us-east-1            # SES region
# AWS_ACCESS_KEY_ID=              # IAM access key with ses:SendEmail
# AWS_SECRET_ACCESS_KEY=          # IAM secret key
# SES_CONFIGURATION_SET_NAME=     # optional config set

# Agent container env — injected by DockerAgentManager; 
# !!! DO NOT SET MANUALLY !!!
# AGENT_ID=
# SESSION_ID=
# AGENT_CONFIG=
# TOOL_POLICY=

# Agent runtime — orchestration overrides (optional; defaults work for local dev)
# RUNTIME_BACKEND=docker            # scheduler backend: docker | nomad | stub (default: docker)
# AGENT_RUNTIME_MODE=docker        # docker | stub (default: stub)
# DOCKER_HOST=tcp://docker-proxy:2375
# DOCKER_NETWORK=herobids_default
# AGENT_IMAGE=herobids-agent:latest
# LLM_TICK_INTERVAL_MS=900000      # agent reasoning loop interval in ms (worker-side ENV_OVERRIDE)
# LLM_HEARTBEAT_INTERVAL_MS=5000   # agent heartbeat cadence in ms (worker-side ENV_OVERRIDE)
# TICK_INTERVAL_MS=900000          # in-container reasoning loop interval; injected per agent by the worker
# HEARTBEAT_INTERVAL_MS=5000       # in-container heartbeat cadence; injected per agent by the worker
# USAGE_BILLING_RATE_CARD=default  # runtime-usage rate-card name (optional; injected into the agent container)
# USAGE_BILLING_RUNTIME_WINDOW_MS=60000  # runtime-usage charge window in ms (optional; injected into the agent container)

# Venue endpoints — optional operator overrides (defaults live in config/default.yaml)
# JUPITER_API_URL=               # Jupiter swap base URL
# HYPERLIQUID_BASE_URL=          # Hyperliquid REST base URL
# HYPERLIQUID_WS_URL=            # Hyperliquid websocket URL
# HYPERLIQUID_TESTNET=false      # true = use Hyperliquid testnet endpoints
# BYBIT_BASE_URL=                # Bybit REST base URL
# BYBIT_WS_URL=                  # Bybit private websocket URL
# BYBIT_WS_PUBLIC_URL=           # Bybit public websocket URL
# BYBIT_TESTNET=false            # true = use Bybit testnet endpoints
# ONEINCH_BASE_URL=              # 1inch swap API base URL
# ONEINCH_RPC_URL=               # EVM RPC URL used by the 1inch adapter
# ONEINCH_CHAIN_ID=8453          # EVM chain id for the 1inch adapter
# ONEINCH_ROUTER_ADDRESS=        # 1inch router contract address (0x… ; per-deployment, no default)

# Agent evaluation
# EVALUATION_STORAGE_ROOT=       # dir for evaluation output (optional; default in config/default.yaml)

# Shared-service connectivity — override with private IPs for cluster deployments
# (defaults use Compose service names for local dev; see config/default.yaml)
# SHARED_REDIS_HOST=redis
# SHARED_REDIS_PORT=6379
# SHARED_POSTGRES_HOST=postgres
# SHARED_POSTGRES_PORT=5432
# SHARED_POSTGRES_USER=herobids
# SHARED_POSTGRES_PASSWORD=herobids
# SHARED_POSTGRES_DATABASE=herobids

# Platform Assessor — optional operator overrides (defaults in config/default.yaml)
# PLATFORM_ASSESSOR_ENABLED=false
# PLATFORM_ASSESSOR_CACHE_FRESHNESS_MS=

# Nomad runtime backend — only used when the runtime backend is 'nomad'
# NOMAD_ADDR=http://localhost:4646   # Nomad API URL
# NOMAD_TOKEN=                       # Nomad ACL token
# NOMAD_AGENT_IMAGE=herobids-agent:latest   # agent task image override (nomad backend only)

# Traderton REST boundary (L3a) — the boundary service herobids consumes.
# Defaults in config/default.yaml point at the local compose boundary.
# TRADERTON_BOUNDARY_URL=http://localhost:8080   # boundary base URL
TRADERTON_BOUNDARY_HMAC_SECRET=                  # HMAC signing secret shared with the boundary
# TRADERTON_BOUNDARY_CONSUMER_ID=herobids        # consumer identifier presented to the boundary
# TRADERTON_BOUNDARY_KEY_ID=current              # HMAC key id presented to the boundary
# TRADERTON_BOUNDARY_TIMEOUT_MS=10000            # per-request timeout in ms

# ── Infrastructure ────────────────────────────────────────
# HCLOUD_TOKEN is only used by Terraform/Hetzner CLI — do NOT store it in .env.
# Set it via: export HCLOUD_TOKEN=... or terraform.tfvars (gitignored)
