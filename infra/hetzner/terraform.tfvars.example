# ─────────────────────────────────────────────────────────────
# Terraform Variables Template — Herobids Hetzner Deployment
# ─────────────────────────────────────────────────────────────
#
# Copy this file to terraform.tfvars and fill in your values:
#
#   cp terraform.tfvars.example terraform.tfvars
#
# For environment-specific setup, use the separate templates:
#   cp staging.tfvars.example staging.tfvars
#   cp production.tfvars.example production.tfvars
#
# terraform.tfvars is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Environment ───────────────────────────────────────────

# environment = "production"   # staging | production (default: production)
#                              # Controls naming conventions, labels, and compose overlay selection.
#                              #   production → server_name=herobids, app_domain=herobids.com
#                              #   staging    → server_name=herobids-staging, app_domain=staging.herobids.com

# ── Provider ──────────────────────────────────────────────

hcloud_token = "your-hetzner-cloud-api-token"  # required, sensitive

# ── Server ────────────────────────────────────────────────

# server_name = "herobids"          # override if default convention doesn't fit
# server_type = "cx23"
# location    = "fsn1"
# image       = "ubuntu-24.04"

# ── SSH ───────────────────────────────────────────────────

ssh_public_key_path = "~/.ssh/id_ed25519.pub"  # required

deploy_ssh_private_key = <<-EOT
-----BEGIN OPENSSH PRIVATE KEY-----
your-private-key-content-here
-----END OPENSSH PRIVATE KEY-----
EOT
# required, sensitive — the private key used as a deploy key for git clone

# ── Deployment ────────────────────────────────────────────

git_repo_url = "git@github.com:your-org/herobids.git"  # required

# git_branch = "main"
# app_domain = "herobids.com"

# ── Nomad Orchestration (Feature 004 — Agent Orchestration) ──

# enable_nomad = true            # Feature flag: provision Nomad cluster + agent nodes.
#                                # Set to false for single-server environments without agent orchestration.
# nomad_version = "1.9.7"       # Nomad version to install

# ── Private Network ───────────────────────────────────────
# Each environment gets its own private network for control-plane ↔ agent node communication.
# Staging and production MUST use non-overlapping IP ranges if they share a Hetzner project.

# network_zone     = "eu-central"        # Hetzner network zone
# network_ip_range = "10.0.0.0/16"       # Private network CIDR (staging default)
#                                         # Production: use 10.1.0.0/16
# subnet_ip_range  = "10.0.0.0/24"       # Subnet within network_ip_range

# ── Agent Node Pool ───────────────────────────────────────
# Agent nodes are disposable Nomad clients. The autoscaler (Phase 6) adjusts agent_node_count at runtime.

# agent_node_count        = 0         # Current number of agent nodes
# min_agent_nodes         = 0         # Scale-in floor
# max_agent_nodes         = 5         # Scale-out ceiling
# agent_node_server_type  = "cpx21"   # Hetzner instance type for agent nodes

# ── Admin Alerting (Phase 8) ───────────────────────────────

# alert_failure_threshold            = 3     # consecutive failures before alert
# alert_rate_limit_seconds           = 3600  # min seconds between alerts (1 hour)
# alert_send_recovery                = "false" # send recovery email on resume
# alert_smtp_host                    = ""    # SMTP relay hostname (leave empty to disable)
# alert_smtp_port                    = 587   # SMTP relay port
# alert_smtp_use_tls                 = "true" # use TLS for SMTP
# alert_from                         = ""    # from address for alerts
# alert_to                           = ""    # recipient (default admin)
# alert_smtp_user                    = ""    # SMTP auth username (sensitive)
# alert_smtp_pass                    = ""    # SMTP auth password (sensitive)

# ─────────────────────────────────────────────────────────────
# Sensitive variables (hcloud_token, deploy_ssh_private_key)
# are marked sensitive in Terraform and will not appear in
# plan/apply output. Store terraform.tfvars securely.
# ─────────────────────────────────────────────────────────────
