# ─────────────────────────────────────────────────────────────
# Staging Terraform Variables — Herobids Hetzner Deployment
# ─────────────────────────────────────────────────────────────
#
# Copy this file to staging.tfvars and fill in your values:
#
#   cp staging.tfvars.example staging.tfvars
#
# Then provision with:
#   ./scripts/provision.sh --env staging --var-file staging.tfvars
#
# staging.tfvars is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Environment ───────────────────────────────────────────

environment = "staging"

# ── Provider ──────────────────────────────────────────────

hcloud_token = "your-hetzner-cloud-api-token"  # required, sensitive

# ── Server ────────────────────────────────────────────────

server_name = "herobids-staging"
# server_type = "cx23"
# location    = "fsn1"
# image       = "ubuntu-24.04"

# ── SSH ───────────────────────────────────────────────────

ssh_public_key_path = "~/.ssh/id_ed25519.pub"  # required

deploy_ssh_private_key = <<-EOT
-----BEGIN OPENSSH PRIVATE KEY-----
your-private-key-content-here
-----END OPENSSH PRIVATE KEY-----
EOT
# required, sensitive — the private key used as a deploy key for git clone

# ── Deployment ────────────────────────────────────────────

git_repo_url = "git@github.com:your-org/herobids.git"  # required
# git_branch = "main"
app_domain = "staging.herobids.com"

# ── Nomad Orchestration ───────────────────────────────────

# enable_nomad = true            # feature flag
# nomad_version = "1.9.7"

# ── Private Network ───────────────────────────────────────
# Staging network: 10.0.0.0/16 (do NOT overlap with production's 10.1.0.0/16)
#
# ⚠️  MANUAL CHECK REQUIRED: Verify subnet_ip_range falls within network_ip_range.
#     Terraform cannot fully validate CIDR containment at plan time.
#     Example: network_ip_range = "10.0.0.0/16" + subnet_ip_range = "10.0.0.0/24" ✓
#              network_ip_range = "10.0.0.0/16" + subnet_ip_range = "10.1.0.0/24" ✗

# network_zone     = "eu-central"
# network_ip_range = "10.0.0.0/16"
# subnet_ip_range  = "10.0.0.0/24"

# ── Agent Node Pool ───────────────────────────────────────

# agent_node_count        = 0    # autoscaler adjusts at runtime
# min_agent_nodes         = 0    # allow scale-in to 0
# max_agent_nodes         = 3    # small pool for staging
# agent_node_server_type  = "cpx21"

# ─────────────────────────────────────────────────────────────
# Sensitive variables (hcloud_token, deploy_ssh_private_key)
# are marked sensitive in Terraform and will not appear in
# plan/apply output. Store staging.tfvars securely.
# ─────────────────────────────────────────────────────────────
