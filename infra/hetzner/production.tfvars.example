# ─────────────────────────────────────────────────────────────
# Production Terraform Variables — Herobids Hetzner Deployment
# ─────────────────────────────────────────────────────────────
#
# Copy this file to production.tfvars and fill in your values:
#
#   cp production.tfvars.example production.tfvars
#
# Then provision with:
#   ./scripts/provision.sh --env production --var-file production.tfvars
#
# production.tfvars is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Environment ───────────────────────────────────────────

environment = "production"

# ── Provider ──────────────────────────────────────────────

hcloud_token = "your-hetzner-cloud-api-token"  # required, sensitive

# ── Server ────────────────────────────────────────────────

server_name = "herobids"
# server_type = "cx23"
# location    = "fsn1"
# image       = "ubuntu-24.04"

# ── SSH ───────────────────────────────────────────────────

ssh_public_key_path = "~/.ssh/id_ed25519.pub"  # required

deploy_ssh_private_key = <<-EOT
-----BEGIN OPENSSH PRIVATE KEY-----
your-private-key-content-here
-----END OPENSSH PRIVATE KEY-----
EOT
# required, sensitive — the private key used as a deploy key for git clone

# ── Deployment ────────────────────────────────────────────

git_repo_url = "git@github.com:your-org/herobids.git"  # required
# git_branch = "main"
app_domain = "herobids.com"

# ── Nomad Orchestration ───────────────────────────────────

# enable_nomad = true            # feature flag
# nomad_version = "1.9.7"

# ── Private Network ───────────────────────────────────────
# Production network: 10.1.0.0/16 (do NOT overlap with staging's 10.0.0.0/16)
#
# ⚠️  MANUAL CHECK REQUIRED: Verify subnet_ip_range falls within network_ip_range.
#     Terraform cannot fully validate CIDR containment at plan time.
#     Example: network_ip_range = "10.1.0.0/16" + subnet_ip_range = "10.1.0.0/24" ✓
#              network_ip_range = "10.1.0.0/16" + subnet_ip_range = "10.0.0.0/24" ✗

# network_zone     = "eu-central"
# network_ip_range = "10.1.0.0/16"
# subnet_ip_range  = "10.1.0.0/24"

# ── Agent Node Pool ───────────────────────────────────────

# agent_node_count        = 0    # autoscaler adjusts at runtime
# min_agent_nodes         = 1    # keep at least 1 node
# max_agent_nodes         = 10   # room to grow
# agent_node_server_type  = "cpx21"

# ── Autoscale Configuration ───────────────────────────────

# scale_out_cooldown_seconds    = 300  # 5 min between scale-out events
# scale_out_memory_threshold_pct = 20   # scale when free memory < 20%
# scale_out_slot_threshold       = 3    # scale when free slots < 3
# scale_out_increment            = 1    # add 1 node per event
# agent_memory_reservation_mb    = 256  # MB per agent slot (scheduling reservation)

# ─────────────────────────────────────────────────────────────
# Sensitive variables (hcloud_token, deploy_ssh_private_key)
# are marked sensitive in Terraform and will not appear in
# plan/apply output. Store production.tfvars securely.
# ─────────────────────────────────────────────────────────────
