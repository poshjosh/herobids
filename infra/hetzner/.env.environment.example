NODE_ENV=
LOG_FORMAT=pretty # pretty | json; auto-set to pretty when NODE_ENV=development

# Authentication
AUTH_JWT_SECRET=

# login/registration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# agentic email sending
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Alerting
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# public HTTPS URL for setWebhook (e.g. https://api.example.com/api/telegram/webhook); omit for local dev
TELEGRAM_WEBHOOK_URL=

# Credential encryption (64 hex chars = 32 bytes for AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

# LLM_API_KEY — generic fallback used when no provider-specific key is found
# Our generic fallback is deepseek for now
#LLM_API_KEY=
# LLM_API_KEY_DEEPSEEK=
LLM_API_KEY_OPENROUTER=
# LLM_API_KEY_ANTHROPIC=
# LLM_API_KEY_OPENAI=

# Web search tool — https://tavily.com (free tier: 1,000 credits/month, no card required)
TAVILY_API_KEY=

SCRAPFLY_API_KEY=

# Market data providers
# required when marketData.birdeye.enabled is true; https://birdeye.so/developers
BIRDEYE_API_KEY=
# required when marketData.coinMarketCap.enabled is true; https://coinmarketcap.com/api/
COINMARKETCAP_API_KEY=
# required when venues.1inch.walletGeneration.enabled is true
ONEINCH_API_KEY=
# required when venues.jupiter.walletGeneration.enabled is true
JUPITER_API_KEY=

# Venue RPC endpoints (credentials stored encrypted in DB — see scripts/.env.example)
BASE_RPC_URL=
SOLANA_RPC_URL=

# Billing — Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Billing — Creem
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=

# Email — outbound delivery via Amazon SES.
EMAIL_PROVIDER=ses
EMAIL_FROM_EMAIL=noreply@openaidom.com
EMAIL_REPLY_TO_EMAIL=support@openaidom.com
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# SES_CONFIGURATION_SET_NAME=     # optional config set

# Nomad orchestration
RUNTIME_BACKEND=nomad
NOMAD_ADDR=
SHARED_REDIS_HOST=
SHARED_POSTGRES_HOST=

# Nomad ACL token (added by setup-nomad.sh)
NOMAD_TOKEN=

# Traderton REST service — the trading service herobids consumes.
# Defaults in config/default.yaml point at the local compose boundary.
TRADERTON_BOUNDARY_URL=https://api.staging.traderton.com         # boundary base URL
TRADERTON_BOUNDARY_HMAC_SECRET=
TRADERTON_BOUNDARY_CONSUMER_ID=herobids                          # consumer identifier presented to the boundary
TRADERTON_BOUNDARY_KEY_ID=herobids-k1                            # HMAC key id presented to the boundary
