# S3 backend credentials for Terraform state and autoscale operations.
#
# Copy this file and fill in your values:
#   cp .env.backend.example .env.backend
#
# Then use with provision.sh and deploy.sh:
#   ./scripts/provision.sh --env staging --var-file staging.tfvars --backend-env-file .env.backend
#   ./deploy.sh --env staging --env-file .env.staging --backend-env-file .env.backend
#
# This file is gitignored — never commit real credentials.

# S3 backend (required)
TF_BACKEND_BUCKET=your-terraform-state-bucket
TF_BACKEND_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# State locking (optional, recommended for production)
TF_BACKEND_DYNAMODB_TABLE=

# Nomad ACL token (set after bootstrapping ACLs on the server)
NOMAD_ACL_TOKEN=
