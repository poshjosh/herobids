# Copy this file to .env.test and fill in testnet credentials.
# .env.test is gitignored — never commit it.
#
# Used by: pnpm test:venues
# Loads venue adapter integration tests that are skipped when these vars are absent.
#
# These tests hit real testnet endpoints and should NOT run in CI by default.
# Run manually: pnpm test:venues

# Hyperliquid testnet (https://app.hyperliquid-testnet.xyz → API → Generate API key)
HYPERLIQUID_TESTNET_API_KEY=      # agent wallet address
HYPERLIQUID_TESTNET_SECRET=       # agent wallet private key
HYPERLIQUID_TESTNET_ACCOUNT_ADDRESS=  # main account address

# Bybit testnet (https://testnet.bybit.com → API Management)
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_SECRET=

# 1inch / Base (mainnet keys — tests use read-only quote endpoint, no transactions)
ONEINCH_API_KEY=
ONEINCH_PRIVATE_KEY=              # only needed for swap execution tests
BASE_RPC_URL=                     # Base RPC endpoint (default: https://mainnet.base.org)
