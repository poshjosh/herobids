# syntax=docker/dockerfile:1
# Agent runtime image — lean container for agent reasoning loop.
# Built from monorepo root: docker build -f docker/Dockerfile.agent -t herobids-agent:latest .
# Does NOT include bot actor, BullMQ worker, or trading engine code.
# Network tools are included for sandbox-egress.sh.

FROM node:22-alpine AS base
RUN corepack enable

# ── build: install all deps and compile TypeScript ───────────────────────────
FROM base AS build
WORKDIR /app
COPY . .
# GitHub Packages auth for @poshjosh/contracts (scope-only .npmrc; token from
# the NPM_TOKEN build secret, never baked into the image). The secret is mounted
# as a file at /run/secrets/NPM_TOKEN; read it (not an env var) so the token is
# never captured in an image layer.
RUN --mount=type=secret,id=NPM_TOKEN \
    --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    sh -c 'printf "//npm.pkg.github.com/:_authToken=%s\n" "$(cat /run/secrets/NPM_TOKEN)" >> .npmrc && pnpm install --frozen-lockfile'
RUN pnpm --filter @herobids/domain run build && \
    pnpm --filter @herobids/llm run build && \
    pnpm --filter @herobids/db run build && \
    pnpm --filter @herobids/worker run build

# ── deploy: agent entry point only ───────────────────────────────────────────
FROM build AS deploy
RUN echo "inject-workspace-packages=true" >> .npmrc && \
    pnpm --filter @herobids/worker deploy --prod /deploy/agent
    
# ── runtime image ─────────────────────────────────────────────────────────────
# Installs the iptables tools used by scripts/sandbox-egress.sh (run at container start).
# CAP_NET_ADMIN is required at run-time to install the egress rules. CAP_SYS_ADMIN is not
# needed: the sandbox no longer creates a network namespace.
FROM node:22-alpine AS runtime

RUN apk add --no-cache iproute2 iptables ip6tables python3 py3-pip git sudo

# Install agent-browser CLI (Rust binary, connects to remote Browserless —
# no local Chrome needed). Pinned to a specific version for reproducibility.
# Requires gcompat (glibc shim) because the pre-built binary links against glibc.
# Retried because a transient registry or network failure once broke this step during a deploy.
RUN for attempt in 1 2 3; do \
      apk add --no-cache gcompat && npm install -g agent-browser@0.14.0 && npm cache clean --force && break; \
      [ "$attempt" -lt 3 ] || exit 1; \
      echo "agent-browser install attempt $attempt failed; retrying in 10s"; sleep 10; \
    done

# Non-root agent user with passwordless sudo. This is intentional: full permission
# mode is root access by design. Standard mode runs commands as 'agent' via
# `sudo -u agent`. Because 'agent' can sudo, the UID-based egress rules are a
# guardrail, not a security boundary (see scripts/sandbox-egress.sh).
# The container starts as root so the entrypoint can install the egress rules.
RUN adduser -D -h /home/agent agent && \
    echo "agent ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/agent && \
    chmod 0440 /etc/sudoers.d/agent

WORKDIR /app/apps/worker

COPY --from=build /app/config /app/config
COPY --from=deploy /deploy/agent ./
# Sandbox gate used by execute_shell and execute_code, and the egress rule installer
# that the entrypoint runs when the container has NET_ADMIN.
COPY scripts/sandbox-exec.sh /usr/local/bin/sandbox-exec.sh
COPY scripts/sandbox-egress.sh /usr/local/bin/sandbox-egress.sh
RUN chmod +x /usr/local/bin/sandbox-exec.sh /usr/local/bin/sandbox-egress.sh

# Agent entrypoint — writes runtime config (e.g. agent-browser CDP), then execs CMD.
COPY scripts/agent-entrypoint.sh /usr/local/bin/agent-entrypoint.sh
RUN chmod +x /usr/local/bin/agent-entrypoint.sh

# Workspace root: persists for the lifetime of the container (across ticks)
RUN mkdir -p /workspace /workspace/sandbox && \
    chown agent:agent /workspace /workspace/sandbox

# Config is read via environment variables — no YAML file needed in agent container.
# All sensitive values come from env (REDIS_URL, LLM_API_KEY, etc.).
# The agent entry point reads AGENT_ID, SESSION_ID, AGENT_CONFIG from env.
ENTRYPOINT ["/usr/local/bin/agent-entrypoint.sh"]
CMD ["node", "dist/agent.js"]
