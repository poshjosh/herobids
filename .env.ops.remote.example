# .env.ops.remote.example — Copy to .env.ops.staging or .env.ops.prod and fill in.
#
# NEVER commit .env.ops.staging or .env.ops.prod — they contain secrets.
# Both filenames are covered by .gitignore (.env.*).
#
# Syntax: KEY=VALUE — quote values that contain spaces: SETUP_DISPLAY_NAME="Alice Smith"

# ---------------------------------------------------------------------------
# API
# Point this at the production API. HTTPS strongly recommended.
#   Local dev:    http://localhost:3000
#   Production:   https://herobids.com/api
#   via SSH:      http://api:3000  (when running inside Docker network)
# ---------------------------------------------------------------------------

API_BASE_URL=https://api.herobids.com

# ---------------------------------------------------------------------------
# User account
# On first run the script registers the account via /auth/register.
# On subsequent runs it logs in via /auth/login.
# ---------------------------------------------------------------------------

AUTH_EMAIL=
AUTH_PASSWORD=                 # must be ≥ 8 characters
SETUP_DISPLAY_NAME=

ADMIN_EMAIL=
ADMIN_PASSWORD=!

# ---------------------------------------------------------------------------
# Setup mode
#   auto:      if multiple provider secret blocks are fully configured,
#              provisions them all; otherwise falls back to single-provider
#   guided:    single provider via SETUP_PROVIDER + SETUP_LABEL
#   advanced:  credential + connection as separate API calls
# ---------------------------------------------------------------------------

SETUP_MODE=auto
SETUP_PROVIDER=
SETUP_LABEL=

# ---------------------------------------------------------------------------
# Credential  (venue API keys stored encrypted in Herobids)
# Set CREDENTIAL_VENUE to one of: hyperliquid | bybit | 1inch
# Then fill in only the secret block that matches your venue.
# Leave these blank when using auto multi-provider setup.
# ---------------------------------------------------------------------------

CREDENTIAL_VENUE=
CREDENTIAL_LABEL=

# ---------------------------------------------------------------------------
# Connection  (links the credential to a provider)
# CONNECTION_PROVIDER typically matches CREDENTIAL_VENUE.
# Leave these blank when using auto multi-provider setup.
# ---------------------------------------------------------------------------

CONNECTION_PROVIDER=
CONNECTION_LABEL=

# -- Hyperliquid  (required when CREDENTIAL_VENUE=hyperliquid) --
HL_API_KEY=
HL_SECRET=
HL_WALLET_ADDRESS=                 # EVM address: 0x + 40 hex chars

# -- Bybit  (required when CREDENTIAL_VENUE=bybit) --
# BYBIT_API_KEY=
# BYBIT_SECRET=

# -- 1inch  (required when CREDENTIAL_VENUE=1inch) --
# ONEINCH_API_KEY=                 # 1inch developer portal key
# ONEINCH_PRIVATE_KEY=             # Wallet private key: 64 hex chars, optional 0x prefix

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------

TELEGRAM_CHAT_ID=123456789
