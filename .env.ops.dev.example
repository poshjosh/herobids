# .env.ops.dev — Single env file for ALL local tests and setup scripts.
# Copy to .env.ops.dev and fill in your values.
# .env.ops.dev is gitignored — never commit it.
#
# Used by:
#   - Shell test scripts (agent-trade-test.sh, bot-trade-test.sh, etc.)
#   - Setup scripts (quick-setup.sh, create-agents.sh, build-and-run.sh)
#   - Ops scripts (fund-hyperliquid.sh, apply-db-squash-fixup.sh)
#   - Venue validation (validate-1inch.sh, validate-jupiter.sh)
#   - Vitest integration tests (pnpm test:venues)
#
# Syntax: KEY=VALUE — quote values containing spaces: DISPLAY_NAME="Alice Smith"

# ===========================================================================
# IDENTITY MODEL — Hyperliquid has 3 distinct addresses/keys:
# ===========================================================================
#
# ┌─────────────────────────────────────┬──────────────────────────────────────────────────────────────────┐
# │ Concept                             │ Description                                                      │
# ├─────────────────────────────────────┼──────────────────────────────────────────────────────────────────┤
# │ Account address                     │ Your main Hyperliquid identity. Shown top-right on               │
# │ (HL_WALLET_ADDRESS,                 │ app.hyperliquid.xyz. Holds funds. Owns positions.                │
# │  HYPERLIQUID_ACCOUNT_ADDRESS)       │ Used to query balances/positions via the info API.               │
# ├─────────────────────────────────────┼──────────────────────────────────────────────────────────────────┤
# │ Agent (API) wallet address          │ A separate address generated via HL dashboard                    │
# │ (HL_API_KEY,                        │ (API → Generate API key). Authorized to submit orders            │
# │  HYPERLIQUID_API_KEY)               │ on behalf of your account address.                               │
# ├─────────────────────────────────────┼──────────────────────────────────────────────────────────────────┤
# │ Agent (API) wallet private key      │ The private key for the agent wallet above.                      │
# │ (HL_SECRET, HYPERLIQUID_SECRET)     │ Signs order payloads. Never sent to HL servers.                  │
# ├─────────────────────────────────────┼──────────────────────────────────────────────────────────────────┤
# │ EVM wallet private key              │ The private key for your main EVM wallet (Base/Arbitrum).        │
# │ (BASE_WALLET_PRIVATE_KEY)           │ Used only for bridging USDC to Hyperliquid. Not needed           │
# │                                     │ for trading. The corresponding public address is your            │
# │                                     │ HL_WALLET_ADDRESS (HYPERLIQUID_ACCOUNT_ADDRESS).                 │
# └─────────────────────────────────────┴──────────────────────────────────────────────────────────────────┘
#
# If you trade with your main wallet directly (no agent key), then:
#   HL_API_KEY = HL_WALLET_ADDRESS
#   HL_SECRET  = BASE_WALLET_PRIVATE_KEY
#
# HL_API_KEY is NOT your account address — it's a separate agent wallet.
# BASE_WALLET_PRIVATE_KEY's public address = HL_WALLET_ADDRESS.

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------

API_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Test user account
# Created automatically on first run. Reused on subsequent runs.
# ---------------------------------------------------------------------------

TEST_EMAIL=trade-test@local.test
TEST_PASSWORD=TradeTest123!

# ---------------------------------------------------------------------------
# Admin seeding (seed-admin.ts, build-and-run.sh, shadow mode tests)
# ---------------------------------------------------------------------------

ADMIN_EMAIL=admin@herobids.local
ADMIN_PASSWORD=AdminTest123!

# ---------------------------------------------------------------------------
# Setup user (quick-setup.sh, create-agents.sh)
# ---------------------------------------------------------------------------

SETUP_EMAIL=you@example.com
SETUP_PASSWORD=changeme123          # must be ≥ 8 characters
SETUP_DISPLAY_NAME=Alice

# ---------------------------------------------------------------------------
# Setup mode (quick-setup.sh)
# auto: if multiple provider secret blocks are fully configured, provisions
# them all via guided setup. Otherwise falls back to single-provider setup.
# ---------------------------------------------------------------------------

SETUP_MODE=auto
SETUP_PROVIDER=
SETUP_LABEL=

# ---------------------------------------------------------------------------
# Credential (venue API keys stored encrypted in HeroBids)
# Set CREDENTIAL_VENUE to one of: hyperliquid | bybit | 1inch
# Leave these blank when using auto multi-provider setup.
# ---------------------------------------------------------------------------

CREDENTIAL_VENUE=
CREDENTIAL_LABEL=

# ---------------------------------------------------------------------------
# Connection (links the credential to a provider)
# Creates a companion venue account automatically.
# CONNECTION_PROVIDER typically matches CREDENTIAL_VENUE.
# Leave these blank when using auto multi-provider setup.
# ---------------------------------------------------------------------------

CONNECTION_PROVIDER=
CONNECTION_LABEL=

# ---------------------------------------------------------------------------
# Venue
# ---------------------------------------------------------------------------

VENUE=hyperliquid          # hyperliquid | bybit | 1inch

# -- Hyperliquid (required when VENUE=hyperliquid) --
HL_API_KEY=
HL_SECRET=
HL_WALLET_ADDRESS=         # EVM address: 0x + 40 hex chars

# Legacy aliases — set to the SAME values as HL_* above.
# Required by fund-hyperliquid.ts and rollout-*.sh.
HYPERLIQUID_API_KEY=          # same as HL_API_KEY
HYPERLIQUID_SECRET=           # same as HL_SECRET
HYPERLIQUID_ACCOUNT_ADDRESS=  # same as HL_WALLET_ADDRESS

# Hyperliquid testnet credentials.
# Obtain at https://app.hyperliquid-testnet.xyz → API → Generate API key.
HYPERLIQUID_TESTNET_API_KEY=
HYPERLIQUID_TESTNET_SECRET=
HYPERLIQUID_TESTNET_ACCOUNT_ADDRESS=

# -- Bybit (required when VENUE=bybit) --
BYBIT_API_KEY=
BYBIT_SECRET=

# Bybit testnet
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_SECRET=

# -- 1inch swap (required when VENUE=1inch) --
ONEINCH_API_KEY=           # 1inch developer portal API key
ONEINCH_PRIVATE_KEY=       # EVM wallet private key (hex, 0x-prefixed)

# -- Jupiter swap --
SOLANA_WALLET_PRIVATE_KEY=
SOLANA_RPC_URL=

# -- Base RPC (used by 1inch tests) --
BASE_RPC_URL=              # default: https://mainnet.base.org

# ---------------------------------------------------------------------------
# Bridging (fund-hyperliquid.sh)
# ---------------------------------------------------------------------------

# EVM private key for the wallet on Base (and Arbitrum — same key).
# The public address derived from this key IS your HL_WALLET_ADDRESS.
BASE_WALLET_PRIVATE_KEY=

# Integer USD amount to bridge (e.g. 20 sends $20 USDC).
AMOUNT_USDC=20

# ---------------------------------------------------------------------------
# LLM provider — required for agent creation. The agent needs a model
# to reason with. If omitted, the defaults below are used.
# ---------------------------------------------------------------------------

LLM_PROVIDER=ollama                     # ollama | openai | deepseek | anthropic
LLM_LIGHT_MODEL=qwen3:8b                # fast/cheap model for tactical decisions
LLM_HEAVY_MODEL=qwen3.6:35b-a3b-q4_K_M  # powerful model for strategic decisions

# ---------------------------------------------------------------------------
# Execution behaviour
# ---------------------------------------------------------------------------

EXECUTION_MODE=paper       # paper | shadow | live
TICK_INTERVAL_MS=60000     # 60 s — fast enough for a test
TIMEOUT_MS=600000          # 10 min total watch window

# ---------------------------------------------------------------------------
# Docker Compose lifecycle (agent-trade-test.sh, bot-trade-test.sh)
# ---------------------------------------------------------------------------

# Set to 1 to auto-start docker compose when the API is not reachable
DOCKER_COMPOSE_UP=0

# Set to 1 to run docker compose down when the test finishes
# (only takes effect if DOCKER_COMPOSE_UP=1 and this script started the stack)
DOCKER_COMPOSE_DOWN=0

# Set to 1 to skip teardown — leaves the agent/bot running for manual inspection
SKIP_TEARDOWN=0

# ---------------------------------------------------------------------------
# Telegram messaging test (test-telegram-messaging.sh)
# ---------------------------------------------------------------------------

TELEGRAM_BOT_TOKEN=

# Expected webhook URL — the script asserts this is registered with Telegram.
# Leave blank to skip the webhook registration check.
# Production: https://herobids.com/api/telegram/webhook
# Staging:    https://staging.herobids.com/api/telegram/webhook
EXPECTED_WEBHOOK_URL=https://herobids.com/api/telegram/webhook

# Chat IDs to verify reachability (comma-separated)
TEST_CHAT_IDS=6846862012,8681143261

# ---------------------------------------------------------------------------
# Notifications (quick-setup.sh)
# ---------------------------------------------------------------------------

TELEGRAM_CHAT_ID=123456789

# ---------------------------------------------------------------------------
# Ollama (build-and-run.sh, load-ollama-agents.sh)
# ---------------------------------------------------------------------------

# Set to 0/false/no to skip automatic model warmup during build-and-run/reset-and-run
PRELOAD_OLLAMA_MODELS=1

# ---------------------------------------------------------------------------
# Rollout / encryption (rollout-stage-*.sh, rollout-check-prerequisites.sh)
# ---------------------------------------------------------------------------

# AES-256-GCM encryption key — 64 hex chars (32 bytes).
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=
