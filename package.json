{
  "name": "herobids",
  "version": "0.0.1",
  "private": true,
  "description": "AI first trading",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:integration": "vitest run --no-file-parallelism packages/db/src/journal-pg.integration.test.ts packages/db/src/alert-delivery-repository.integration.test.ts apps/api/src/plugins/auth.integration.test.ts apps/api/src/routes/auth-oauth.integration.test.ts",
    "test:venues": "vitest run --config vitest.integration.config.ts",
    "test:functional": "vitest run --no-file-parallelism apps/api/src/__tests__/functional apps/worker/src/__tests__/integration",
    "lint": "tsc --noEmit",
    "clean": "pnpm -r run clean"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
