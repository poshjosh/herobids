# .env.test.example — Copy to scripts/shell/tests/.env.test and fill in your values.
# Used by: scripts/shell/tests/test-telegram-messaging.sh
#
# NEVER commit scripts/shell/tests/.env.test — it contains secrets.
# scripts/shell/tests/.env* is already in .gitignore.
#
# Syntax: KEY=VALUE

# ---------------------------------------------------------------------------
# HeroBids API (for health check only)
# ---------------------------------------------------------------------------

HEROBIDS_API_URL=https://herobids.com

# ---------------------------------------------------------------------------
# Telegram Bot
# ---------------------------------------------------------------------------

TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Expected webhook URL — the script asserts this is registered with Telegram.
# Leave blank to skip the webhook registration check.
# ---------------------------------------------------------------------------

EXPECTED_WEBHOOK_URL=https://herobids.com/api/telegram/webhook

# ---------------------------------------------------------------------------
# Chat IDs to verify reachability (comma-separated)
# ---------------------------------------------------------------------------

TEST_CHAT_IDS=6846862012,8681143261
