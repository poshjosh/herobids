# Copy this file to scripts/.env and fill in your values.
# scripts/.env is gitignored — never commit it.

# ===========================================================================
# IDENTITY MODEL — Hyperliquid has 3 distinct addresses/keys:
# ===========================================================================
#
# ┌─────────────────────────────────────┬──────────────────────────────────────────────────────────────────┐
# │ Concept                             │ Description                                                      │
# ├─────────────────────────────────────┼──────────────────────────────────────────────────────────────────┤
# │ Account address                     │ Your main Hyperliquid identity. Shown top-right on               │
# │ (HYPERLIQUID_ACCOUNT_ADDRESS)       │ app.hyperliquid.xyz. Holds funds. Owns positions.                │
# │                                     │ Used to query balances/positions via the info API.               │
# ├─────────────────────────────────────┼──────────────────────────────────────────────────────────────────┤
# │ Agent (API) wallet address          │ A separate address generated via HL dashboard                    │
# │ (HYPERLIQUID_API_KEY)               │ (API → Generate API key). Authorized to submit orders            │
# │                                     │ on behalf of your account address.                               │
# ├─────────────────────────────────────┼──────────────────────────────────────────────────────────────────┤
# │ Agent (API) wallet private key      │ The private key for the agent wallet above.                      │
# │ (HYPERLIQUID_SECRET)                │ Signs order payloads. Never sent to HL servers.                  │
# ├─────────────────────────────────────┼──────────────────────────────────────────────────────────────────┤
# │ EVM wallet private key              │ The private key for your main EVM wallet (Base/Arbitrum).        │
# │ (BASE_WALLET_PRIVATE_KEY)           │ Used only for bridging USDC to Hyperliquid. Not needed           │
# │                                     │ for trading. The corresponding public address is your            │
# │                                     │ HYPERLIQUID_ACCOUNT_ADDRESS.                                     │
# └─────────────────────────────────────┴──────────────────────────────────────────────────────────────────┘
#
# If you trade with your main wallet directly (no agent key), then:
#   HYPERLIQUID_API_KEY = HYPERLIQUID_ACCOUNT_ADDRESS
#   HYPERLIQUID_SECRET  = BASE_WALLET_PRIVATE_KEY
#
# HYPERLIQUID_API_KEY is NOT your account address — it's a separate agent wallet.
# BASE_WALLET_PRIVATE_KEY's public address = HYPERLIQUID_ACCOUNT_ADDRESS.
# ===========================================================================

# ---------------------------------------------------------------------------
# Admin seeding (seed-admin.ts)
# ---------------------------------------------------------------------------

# Email and password for the first admin user.
# Run: pnpm --filter scripts seed-admin
# Both must be set; the script is idempotent (safe to re-run).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: disable automatic Ollama model warmup during build-and-run/reset-and-run.
# Set to 0/false/no to skip the background warmup helper.
PRELOAD_OLLAMA_MODELS=1

# ---------------------------------------------------------------------------
# Rollout vars (rollout-stage-a/b/c.sh, rollout-check-prerequisites.sh)
# ---------------------------------------------------------------------------

# AES-256-GCM encryption key — 64 hex chars (32 bytes).
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=

# Your main Hyperliquid account address (holds funds, shows positions).
# Shown top-right on app.hyperliquid.xyz.
HYPERLIQUID_ACCOUNT_ADDRESS=0x

# Agent (API) wallet address — generated via HL dashboard → API → Generate.
# This is NOT your account address — it's a separate address authorized to trade.
HYPERLIQUID_API_KEY=0x

# Agent (API) wallet private key — the secret key for the agent address above.
HYPERLIQUID_SECRET=0x

# Hyperliquid testnet credentials (Stage A only).
# Obtain at https://app.hyperliquid-testnet.xyz → API → Generate API key.
HYPERLIQUID_TESTNET_ACCOUNT_ADDRESS=0x
HYPERLIQUID_TESTNET_API_KEY=0x
HYPERLIQUID_TESTNET_SECRET=0x

# ---------------------------------------------------------------------------
# Bridging vars (fund-hyperliquid.ts)
# ---------------------------------------------------------------------------

# EVM private key for the wallet on Base (and Arbitrum — same key).
# The public address derived from this key IS your HYPERLIQUID_ACCOUNT_ADDRESS.
BASE_WALLET_PRIVATE_KEY=0x

# Integer USD amount to bridge (e.g. 20 sends $20 USDC).
AMOUNT_USDC=20
